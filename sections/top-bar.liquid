<div class="top-bar" style="background-color: {{ section.settings.background_color }}; padding: 8px 0; text-align: center; font-size: 13px;">
  <div style="display: flex; justify-content: space-around; max-width: 1200px; margin: 0 auto; flex-wrap: wrap; color: {{ section.settings.text_color }};">
    <span>{{ section.settings.left_text }}</span>
    <span>{{ section.settings.center_text }}</span>
    <span>{{ section.settings.right_text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Top Bar",
  "settings": [
    {
      "type": "text",
      "id": "left_text",
      "label": "Left text",
      "default": "Voor 15:00 Besteld, Morgen In Huis"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center text",
      "default": "Gratis verzending vanaf €50,-"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right text",
      "default": "Gold plated jewellery"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fdf0e9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
